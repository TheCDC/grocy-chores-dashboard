# Copy to .env and fill in.

# --- Grocy connection ---
GROCY_BASE_URL=https://your-grocy-instance.example.com
GROCY_API_KEY=changeme
# Optional:
# GROCY_PORT=9192
# GROCY_VERIFY_SSL=true

# --- Dashboard behavior ---
# Path (inside the container) to the JSON file listing included users,
# display order, and per-user color overrides. This is an include list
# (requirements doc §4) — anyone not listed here (including system/admin
# accounts) never appears, by design. Editable at runtime via the
# settings page (/settings) — see PLAN.md §5. Mount this path as a
# volume (see docker-compose.yml) so edits survive container restarts.
USER_CONFIG_PATH=/data/dashboard_users.json

# How often the dashboard auto-polls Grocy for updates, in seconds.
REFRESH_INTERVAL_SECONDS=30

# Port the dashboard itself listens on inside the container.
DASHBOARD_PORT=8080

# --- Development ---
# Enable NiceGUI's file-watching reload for live code changes on save.
# Set to "true" in docker-compose.dev.yml when running with source mounts.
DEV_RELOAD=false
